# Secrets d'environnement (ne jamais committer — voir .env.example)
.env
.env.*
!.env.example

# Archives sources (ne pas embarquer dans les assets servis)
*.zip


# Vidéo de présentation (160 Mo > limite GitHub 100 Mo) — à héberger sur un CDN
